# ============================================================
# PE_ORIGINALS — Environment configuration
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000
# Public URL the API is served at (used for links in emails)
PUBLIC_URL=http://localhost:5000
# Where the frontend is served from (CORS origin; comma-separated for multiple)
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# ---- Database (PostgreSQL) ----
# Example local: postgresql://postgres:postgres@localhost:5432/pe_originals
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pe_originals

# ---- Redis (cache — OPTIONAL) ----
# Leave EMPTY to run without Redis (cache disabled, app still works).
# Local dev:  redis://localhost:6379
# Railway:    add the Railway Redis plugin and paste its REDIS_URL here.
REDIS_URL=
REDIS_CACHE_TTL=300        # seconds product/category cache lives (5 min)

# ---- Auth / JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_generate_with_node_crypto_randombytes
JWT_REFRESH_SECRET=change_me_generate_with_node_crypto_randombytes
JWT_ACCESS_TTL=15m          # access token lifetime
JWT_REFRESH_TTL=7d          # refresh token lifetime
JWT_ISSUER=pe-originals-api

# ---- Email (Nodemailer) ----
# SMTP (e.g. Gmail app password, Mailgun, SendGrid, Brevo, Resend SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="PE_ORIGINALS <no-reply@peoriginals.com>"
# When true, reset emails are logged to console instead of sent (dev mode)
MAIL_DEV_MODE=true

# ---- Admin bootstrap (used by seed script) ----
# Set these BEFORE running `npm run seed` — they create the first admin login.
ADMIN_EMAIL=admin@peoriginals.com
ADMIN_PASSWORD=ChangeMe_12345
ADMIN_NAME=Store Admin

# ---- Paystack (card payments) ----
# From your Paystack dashboard → Settings → API Keys & Webhooks.
#   • TEST MODE  — use sk_test_ / pk_test_ keys.
#   • LIVE MODE  — flip your Paystack dashboard to Live, then paste
#     sk_live_ / pk_live_ keys here. NEVER commit real keys to git —
#     this file (.env.example) only ever holds placeholders.
#   • Validate your keys: curl https://api.paystack.co/balance
#     -H "Authorization: Bearer <secret key>"  → should NOT say "Invalid key".
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120          # general API requests per minute
AUTH_RATE_LIMIT_MAX=10      # login/register attempts per minute

# ---- Object storage (Railway bucket / S3-compatible) ----
# Used by middleware/uploadS3.js for all admin image uploads
# (products, categories, content blocks). Get these from your
# Railway bucket plugin's connection details.
BUCKET_ENDPOINT=https://your-bucket-endpoint
BUCKET_NAME=your-bucket-name
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=