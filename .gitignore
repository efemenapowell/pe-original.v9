# ============================================================
# PE_ORIGINALS — .gitignore
# Covers: dependencies, secrets, builds, uploads, logs, caches,
# OS/editor junk, and generated artifacts. Keeps the repo clean
# and guarantees NO secrets are ever committed.
# ============================================================

# ---- Dependencies (all levels) ----
node_modules/
**/node_modules/

# ---- Environment & secrets — NEVER commit real keys ----
# .env and all variants are ignored; .env.example (placeholders only) is kept.
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
.env.*.local
.env.*.production
.env.*.staging
.env.*.test
!.env.example

# ---- Build output ----
dist/
build/
out/
*.tsbuildinfo

# ---- Runtime uploads (keep the folder via .gitkeep) ----
backend/uploads/*
!backend/uploads/.gitkeep
frontend/uploads/*
!frontend/uploads/.gitkeep

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.pem

# ---- Test coverage / reports ----
coverage/
reports/
.nyc_output/

# ---- Caches ----
.cache/
.tmp/
tmp/
*.cache

# ---- Prisma (generated client is built at install time) ----
backend/node_modules/.prisma/
backend/node_modules/@prisma/
backend/prisma/*.db
backend/prisma/*.db-journal

# ---- OS / editor / IDE ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.vim
*.iml
*~

# ---- Misc / archives ----
*.zip
*.tar.gz
*.tgz
screenshots/
.vagrant/
.docker/
