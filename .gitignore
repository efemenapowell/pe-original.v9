# ============================================================
# PE_ORIGINALS — .gitignore
# Covers: dependencies, secrets, builds, uploads, logs, caches,
# OS/editor junk, and generated artifacts. Keeps the repo clean
# and guarantees NO secrets are ever committed.
# ============================================================

# ---- Dependencies (all levels) ----
node_modules/
**/node_modules/

# ---- Environment & secrets — NEVER commit real keys ----
# .env and all variants are ignored; .env.example (placeholders only) is kept.
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
.env.*.local
.env.*.production
.env.*.staging
.env.*.test
!.env.example

# ---- Build output ----
dist/
build/
out/
*.tsbuildinfo

# ---- Runtime uploads (keep the folder via .gitkeep) ----
backend/uploads/*
!backend/uploads/.gitkeep
frontend/uploads/*
!frontend/uploads/.gitkeep

# ---- Logs ----
